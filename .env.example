# Example environment variables (do not use this in production)

app_name="LLM-Proxy"
debug=False
host=0.0.0.0
port=5000

# Fake LLM settings
fake_llm_host=0.0.0.0
fake_llm_port=5001

# Feature toggles
proxy_enabled=True
prompt_hub_enabled=True
chain_hub_enabled=True

# Proxy settings
# Upstreams are LLM hub providers: one JSON file per provider in llm_hub_directory.
# Models are routed by "prefix/model"; anything else goes to the provider whose
# "models" list contains the name, then to the provider with "default": true.
llm_hub_directory=data/llm_hub
# data/llm_hub/localllm.json (the default provider) loads only when this is set
LLM_LOCALLLM_BASE_URL="http://localhost:1234"
# Retry / circuit breaker defaults
proxy_recovery_time=30
proxy_window_size=60
proxy_max_retries=5
proxy_base_delay=0.5
proxy_backoff_factor=2.0
proxy_failure_threshold=5

# Prompt hub settings
prompt_hub_directory=data/prompt_hub

# Chain hub settings
chain_hub_directory=data/chain_hub
chain_default_base_url="https://tagme.ift.delta.sbrf.ru/gigachat/v1"
chain_default_model_name="Gigachat:latest"

# OpenTelemetry distributed tracing — separate from the Langfuse business
# tracing. Exports request/httpx spans over OTLP/HTTP to a collector
# such as Tempo.
LLM_OTEL_ENABLED=false
LLM_OTEL_SERVICE_NAME=yallmp
LLM_OTEL_EXPORTER_ENDPOINT=http://tempo:4318
